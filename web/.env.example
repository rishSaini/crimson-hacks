# Copy to .env.local. Public token (pk...) from https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=
# Browser requests use the website origin, including through a shared tunnel.
NEXT_PUBLIC_API_URL=/api
# The Next.js server forwards API requests to this backend.
API_ORIGIN=http://127.0.0.1:8000
# Display basemap: mapbox (default) or usgs (USGS imagery + AWS terrain, no Mapbox raster tiles)
NEXT_PUBLIC_BASEMAP=mapbox
