# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# OpenAI API key for /agent, read from this file when the first request comes in.
OPENAI_API_KEY=
# Not used by the stubs yet.
# Contact email for the User-Agent on UAC requests. UAC may answer 400 without one.
UAC_CONTACT_EMAIL=
# Required by UAC's forecast JSON. Request one at https://utahavalanchecenter.org/api-access
UAC_API_TOKEN=
